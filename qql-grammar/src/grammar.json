{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "qql",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "statement"
      }
    },
    "statement": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "search_statement"
        },
        {
          "type": "SYMBOL",
          "name": "insert_statement"
        }
      ]
    },
    "search_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "command",
          "content": {
            "type": "PATTERN",
            "value": "SEARCH",
            "flags": "i"
          }
        },
        {
          "type": "FIELD",
          "name": "mode",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "VECTOR",
                    "flags": "i"
                  },
                  {
                    "type": "FIELD",
                    "name": "vector",
                    "content": {
                      "type": "SYMBOL",
                      "name": "vector"
                    }
                  }
                ]
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "TEXT",
                    "flags": "i"
                  },
                  {
                    "type": "FIELD",
                    "name": "query_string",
                    "content": {
                      "type": "SYMBOL",
                      "name": "string"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "PATTERN",
          "value": "FROM",
          "flags": "i"
        },
        {
          "type": "FIELD",
          "name": "table",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "JOIN",
                  "flags": "i"
                },
                {
                  "type": "FIELD",
                  "name": "join_table",
                  "content": {
                    "type": "SYMBOL",
                    "name": "identifier"
                  }
                },
                {
                  "type": "PATTERN",
                  "value": "ON",
                  "flags": "i"
                },
                {
                  "type": "FIELD",
                  "name": "join_left",
                  "content": {
                    "type": "SYMBOL",
                    "name": "identifier"
                  }
                },
                {
                  "type": "STRING",
                  "value": "="
                },
                {
                  "type": "FIELD",
                  "name": "join_right",
                  "content": {
                    "type": "SYMBOL",
                    "name": "identifier"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "WHERE",
                  "flags": "i"
                },
                {
                  "type": "FIELD",
                  "name": "condition",
                  "content": {
                    "type": "SYMBOL",
                    "name": "condition"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "temporal",
              "content": {
                "type": "SYMBOL",
                "name": "temporal_clause"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "spatial",
              "content": {
                "type": "SYMBOL",
                "name": "spatial_clause"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "LIMIT",
                  "flags": "i"
                },
                {
                  "type": "FIELD",
                  "name": "limit",
                  "content": {
                    "type": "SYMBOL",
                    "name": "number"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "temporal_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "WITHIN",
          "flags": "i"
        },
        {
          "type": "PATTERN",
          "value": "TIME",
          "flags": "i"
        },
        {
          "type": "FIELD",
          "name": "start_time",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          }
        },
        {
          "type": "PATTERN",
          "value": "TO",
          "flags": "i"
        },
        {
          "type": "FIELD",
          "name": "end_time",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          }
        }
      ]
    },
    "spatial_clause": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "WITHIN",
          "flags": "i"
        },
        {
          "type": "PATTERN",
          "value": "RADIUS",
          "flags": "i"
        },
        {
          "type": "FIELD",
          "name": "radius",
          "content": {
            "type": "SYMBOL",
            "name": "number"
          }
        },
        {
          "type": "PATTERN",
          "value": "OF",
          "flags": "i"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "lat",
          "content": {
            "type": "SYMBOL",
            "name": "number"
          }
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "FIELD",
          "name": "lon",
          "content": {
            "type": "SYMBOL",
            "name": "number"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "insert_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "INSERT",
          "flags": "i"
        },
        {
          "type": "PATTERN",
          "value": "INTO",
          "flags": "i"
        },
        {
          "type": "FIELD",
          "name": "table",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "col1",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "FIELD",
          "name": "col2",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "PATTERN",
          "value": "VALUES",
          "flags": "i"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "val1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "string"
              },
              {
                "type": "SYMBOL",
                "name": "number"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "FIELD",
          "name": "val2",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "string"
              },
              {
                "type": "SYMBOL",
                "name": "number"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "condition": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "left",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "FIELD",
          "name": "op",
          "content": {
            "type": "SYMBOL",
            "name": "operator"
          }
        },
        {
          "type": "FIELD",
          "name": "right",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "number"
              },
              {
                "type": "SYMBOL",
                "name": "string"
              }
            ]
          }
        }
      ]
    },
    "operator": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": ">"
        },
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "STRING",
          "value": ">="
        },
        {
          "type": "STRING",
          "value": "<="
        },
        {
          "type": "STRING",
          "value": "!="
        },
        {
          "type": "PATTERN",
          "value": "LIKE",
          "flags": "i"
        }
      ]
    },
    "vector": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "number"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "STRING",
                        "value": ","
                      },
                      {
                        "type": "SYMBOL",
                        "name": "number"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_\\.]*"
    },
    "string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "PATTERN",
              "value": "[^\"]*"
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "PATTERN",
              "value": "[^']*"
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        }
      ]
    },
    "number": {
      "type": "PATTERN",
      "value": "-?[0-9]+(\\.[0-9]+)?"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "PATTERN",
      "value": "--.*"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}