[Unit]
Description=QIHSE Fleet Fan Control & Thermal Telemetry Agent
After=network.target

[Service]
Type=simple
EnvironmentFile=%E/qihse/machine-principal.env
ExecStart=/usr/bin/python3 ${QIHSE_PREFIX}/bin/qihse-fan-agent --daemon --interval 5
Restart=always
RestartSec=5
# Share explicit principal, tenant, prefix and token path with the refresh unit.
# Install tools/fleet/qihse-fan-agent.py as "$QIHSE_PREFIX/bin/qihse-fan-agent".
# Authentication uses the root-only 0600 file at QIHSE_MACHINE_TOKEN; no Operator
# password fallback is provisioned here. See the refresh unit for deployment.
# The nonce is consumed once per connection. Refresh does not revoke an old
# token, but reconnects using it can be refused; the timer is not a replay fix.

[Install]
WantedBy=multi-user.target
