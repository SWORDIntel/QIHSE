# Root-level build artifacts and binaries
/*.so
/qihse-server
/test_mldsa
/fuzzer

# Root-level patch/fix scripts (one-time use)
/patch_*.py
/fix_*.py

# Root-level cache, logs, and temp files
/qihse_qmag_telemetry.log
/wal.log
/.qihse_auth_cache.dat
/.DS_Store
/__pycache__/

# Root-level test data
/sstable_*.db

